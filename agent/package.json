{
  "name": "@code-dao/saine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SAINE agent harness: builds adjudication packages, runs the ten-model board, signs and relays attestations.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js watch",
    "check": "node dist/src/main.js check",
    "gen:abi": "node scripts/gen-abi.mjs"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0"
  },
  "bin": {
    "saine": "./dist/src/main.js"
  }
}
